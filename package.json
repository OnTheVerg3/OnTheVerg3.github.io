  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hybrid SnakeWorks corporate site and OnTheVerg3 personal portfolio. React 19 + Vite 7 + TypeScript SPA deployed to GitHub Pages.",
  "author": {
    "name": "Aiden",
    "url": "https://OnTheVerg3.github.io"
  },
  "license": "UNLICENSED",
  "homepage": "https://ontheverg3.github.io",
  "repository": {
    "type": "git",
