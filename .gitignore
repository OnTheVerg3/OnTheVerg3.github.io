# =============================================================================
# SnakeWorks Portfolio - .gitignore
#
# Ordered: Node / package managers, Vite build output, TypeScript caches,
# ESLint / Prettier caches, environment & secrets, logs, coverage, OS & IDE.
# =============================================================================

# ---- Node / package manager artifacts ---------------------------------------
node_modules/
jspm_packages/
.pnp/
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.npm/
.pnpm-store/

# ---- Build output -----------------------------------------------------------
dist/
dist-ssr/
build/
out/
.vite/
.vite-inspect/
*.local

# ---- TypeScript -------------------------------------------------------------
*.tsbuildinfo
.tsbuild/

# ---- ESLint / Prettier caches ----------------------------------------------
.eslintcache
.stylelintcache
.prettiercache

# ---- Environment & secrets --------------------------------------------------
# Never commit secrets. .env.example may be committed as a template.
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
*.pem
*.key

# ---- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Coverage / test artifacts ---------------------------------------------
coverage/
.nyc_output/
*.lcov
.jest-cache/

# ---- Vite / Rollup / Vitest temp -------------------------------------------
.vitest-cache/
.cache/
.parcel-cache/
.rollup.cache/
.turbo/

# ---- Editor / IDE -----------------------------------------------------------
# VS Code: ignore per-user settings, keep shared workspace settings if added.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.history/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln.iml
*.sw?

# ---- Operating system noise -------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- Local scratch / personal notes ----------------------------------------
scratch/
TODO.local.md
NOTES.local.md

# ---- Internal / non-public documentation -----------------------------------
# These files were originally committed under SnakeWorks/Portfolio/ but
# have been moved to SnakeWorks/Portfolio-Internal/ (a sibling folder, not
# part of this repo) so they are never pushed to GitHub. Gitignored here
# as defense in depth: if a copy ever lands in the working tree (e.g. a
# stray write from a tool, a paste from agent transcripts) git will not
# pick it up.
ARCHITECTURE.md
PROMPT.md
